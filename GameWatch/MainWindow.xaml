<Window x:Class="GameWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameWatch" Height="900" Width="1180" MinHeight="680" MinWidth="900"
        Background="#1e1e1e">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="Width" Value="130"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="RowBackground" Value="#1e1e1e"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- Custom cell template: the default one pins content to the top
             of the cell. This centres every cell's content vertically, so
             text, icons and checkboxes all line up in taller rows. -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2d2d30"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: header -->
            <RowDefinition Height="Auto"/>   <!-- 1: timestamp -->
            <RowDefinition Height="64"/>     <!-- 2: totals + graph -->
            <RowDefinition Height="Auto"/>   <!-- 3: etw status -->
            <RowDefinition Height="6"/>      <!-- 4: spacer -->
            <RowDefinition Height="Auto"/>   <!-- 5: settings row -->
            <RowDefinition Height="Auto"/>   <!-- 6: alert -->
            <RowDefinition Height="6"/>      <!-- 7: spacer -->
            <RowDefinition Height="*"/>      <!-- 8: tabs -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="GAMEWATCH" FontSize="22" FontWeight="Bold" Foreground="#4fc3f7"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="GAME MODE " FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="GameModeStatusText" Text="OFF" FontSize="14" FontWeight="Bold"
                           Foreground="#888888" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" x:Name="TimestampText" Text="Waiting for first sample..."
                   Margin="0,2,0,6" Foreground="#888888"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DownloadText" Text="↓ -" FontSize="16"/>
                <TextBlock x:Name="UploadText" Text="↑ -" FontSize="16" Margin="14,0,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#161616" Margin="10,0,0,0" CornerRadius="3">
                <Canvas x:Name="TrafficGraphCanvas" ClipToBounds="True" Margin="4"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="EtwStatusText" Text="Per-app rates: starting..."
                   Margin="0,6,0,0" Foreground="#888888" FontSize="12"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button x:Name="SettingsButton" Content="Settings" Padding="12,5" Click="SettingsButton_Click"/>
            <Button x:Name="GameModeButton" Content="Enable Game Mode" Margin="10,0,0,0"
                    Padding="12,5" Click="GameModeButton_Click"/>
        </StackPanel>
        <Popup x:Name="SettingsPopup" Grid.Row="5" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="#2d2d30" BorderBrush="#4fc3f7" BorderThickness="1" Padding="12" Margin="0,4,0,0">
           <StackPanel>
            <TextBlock Text="UI refresh" Margin="0,0,0,4"/>
            <ComboBox x:Name="RefreshSpeedCombo" SelectionChanged="RefreshSpeedCombo_SelectionChanged">
                <ComboBoxItem Content="Low (~5s)"/>
                <ComboBoxItem Content="Normal (~2s)"/>
                <ComboBoxItem Content="Fast (~1s)"/>
            </ComboBox>
            <TextBlock Text="Adapter" Margin="0,10,0,4"/>
            <ComboBox x:Name="AdapterFilterCombo" SelectionChanged="AdapterFilterCombo_SelectionChanged">
                <ComboBoxItem Content="Automatic"/>
                <ComboBoxItem Content="Ethernet"/>
                <ComboBoxItem Content="Wi-Fi"/>
                <ComboBoxItem Content="VPN/Virtual"/>
            </ComboBox>
           </StackPanel>
          </Border>
        </Popup>

        <TextBlock Grid.Row="6" x:Name="AlertText" Text="" Visibility="Collapsed" Margin="0,6,0,0"
                   Foreground="OrangeRed" FontWeight="Bold" FontSize="12"/>

        <TabControl Grid.Row="8" Background="#1e1e1e" Foreground="#e0e0e0" BorderBrush="#3f3f46">
          <TabItem Header="Live activity">
            <Grid Margin="8">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LIVE NETWORK USERS  -  check a row to include it in Game Mode  -  click a column to sort"
                       FontSize="13" Foreground="#4fc3f7" FontWeight="Bold"/>
            <TextBlock Grid.Column="1" x:Name="ConnectionCountText" Text="0 active connections" Foreground="#888888"/>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="ConnectionsGrid" IsReadOnly="False" RowHeight="42" SelectionChanged="ConnectionsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Track" Width="50" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsTracked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="TrackCheckBox_Checked"
                                      Unchecked="TrackCheckBox_Unchecked"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Process" Width="180" SortMemberPath="ProcessName">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ExePath}">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="55" IsReadOnly="True" SortMemberPath="Pid"/>
                <DataGridTextColumn Header="Conns" Binding="{Binding ConnectionCount}" Width="55" IsReadOnly="True" SortMemberPath="ConnectionCount"/>
                <DataGridTextColumn Header="↓ Rate" Binding="{Binding DownloadRateDisplay}" Width="90" IsReadOnly="True" SortMemberPath="DownloadBytesPerSecond"/>
                <DataGridTextColumn Header="↑ Rate" Binding="{Binding UploadRateDisplay}" Width="90" IsReadOnly="True" SortMemberPath="UploadBytesPerSecond"/>
                <DataGridTextColumn Header="Hosted services" Binding="{Binding Services}" Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="Remote endpoints" Binding="{Binding RemoteEndpoints}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" x:Name="LiveEmptyText" Text="Waiting for live process activity..." Foreground="#888888"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Expander Grid.Row="2" Header="Selected process · hosted services and module → endpoints" Foreground="#e0e0e0" Margin="0,8,0,0" IsExpanded="True">
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ServiceDetailsText" Text="Select a process to inspect its connections." TextWrapping="Wrap" Margin="8"/>
          </ScrollViewer>
        </Expander>
            </Grid>
          </TabItem>
          <TabItem Header="Traffic by time">
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="5 min" Tag="5" Padding="8,4" Click="RecentRange_Click"/>
                  <Button Content="15 min" Tag="15" Padding="8,4" Click="RecentRange_Click"/>
                  <Button Content="1 hour" Tag="60" Padding="8,4" Click="RecentRange_Click"/>
                  <Button Content="24 hours" Tag="1440" Padding="8,4" Click="RecentRange_Click"/>
                  <Button Content="All" Padding="8,4" Click="RecentRange_Click"/>
                </StackPanel>
                <TextBlock Text="SELECT A TIME RANGE" Foreground="#4fc3f7" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Grid.Row="1" x:Name="RangeText" Text="Waiting for traffic samples..." Margin="0,12,0,4"/>
              <Canvas Grid.Row="2" x:Name="RangeCanvas" Height="50" Margin="12,0" SizeChanged="RangeCanvas_SizeChanged" Background="Transparent">
                <Polyline x:Name="RangeSparkline" Stroke="#557fb2" StrokeThickness="1" IsHitTestVisible="False"/>
                <Rectangle x:Name="RangeTrack" Height="6" Fill="#3f3f46" RadiusX="3" RadiusY="3" Canvas.Top="22"/>
                <Rectangle x:Name="RangeSelection" Height="6" Fill="#4fc3f7" RadiusX="3" RadiusY="3" Canvas.Top="22"/>
                <Thumb x:Name="StartThumb" Width="20" Height="26" Canvas.Top="12" DragDelta="StartThumb_DragDelta" Cursor="SizeWE" Background="#4fc3f7"/>
                <Thumb x:Name="EndThumb" Width="20" Height="26" Canvas.Top="12" DragDelta="EndThumb_DragDelta" Cursor="SizeWE" Background="#4fc3f7"/>
              </Canvas>
              <Grid Grid.Row="3" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StartRangeLabel" Foreground="#b0bec5"/>
                <TextBlock Grid.Column="1" x:Name="EndRangeLabel" TextAlignment="Right" Foreground="#b0bec5"/>
              </Grid>
              <TextBlock Grid.Row="4" x:Name="RangeTotalsText" Margin="0,6,0,8" FontSize="15" Foreground="#81c784"/>
              <DataGrid Grid.Row="5" x:Name="HistoryGrid" IsReadOnly="True" RowHeight="42" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Application" Width="220" SortMemberPath="ProcessName"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ExePath}"><Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding ProcessName}"/></StackPanel>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Downloaded" Binding="{Binding DownloadDisplay}" Width="150" SortMemberPath="DownloadBytes"/>
                  <DataGridTextColumn Header="Uploaded" Binding="{Binding UploadDisplay}" Width="150" SortMemberPath="UploadBytes"/>
                  <DataGridTextColumn Header="Executable" Binding="{Binding ExePath}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="5" x:Name="HistoryEmptyText" Text="No per-app traffic in this range yet." Foreground="#888888"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock Grid.Row="6" Margin="0,9,0,0" Foreground="#888888" TextWrapping="Wrap"
                         Text="History starts when this app launches and keeps up to 24 hours in memory. Drag both handles to select dates and times. Boundary samples are estimated proportionally."/>
            </Grid>
          </TabItem>
          <TabItem x:Name="DownloadsTab" Header="Downloads">
            <Grid Margin="12">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,10">
                <Button x:Name="RefreshDownloadsButton" DockPanel.Dock="Right" Content="Refresh downloads" Click="RefreshBits_Click" Padding="10,5"/>
                <TextBlock x:Name="BitsStatusText" Text="Refresh to inspect Windows background transfer jobs." Foreground="#4fc3f7" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid Grid.Row="1">
              <DataGrid x:Name="BitsGrid" IsReadOnly="True" RowHeight="42">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="36"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Center"/>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Job" Binding="{Binding Job}" Width="160"/>
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                  <DataGridTextColumn Header="Source / package URL" Binding="{Binding Source}" Width="*"/>
                  <DataGridTextColumn Header="Saved to" Binding="{Binding Destination}" Width="200"/>
                  <DataGridTextColumn Header="Transferred / total" Binding="{Binding ProgressDisplay}" Width="160"/>
                  <DataGridTextColumn Header="Service row" Binding="{Binding ServiceHint}" Width="120"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="BitsEmptyText" Text="No active downloads found." Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <TextBlock Grid.Row="2" Margin="0,9,0,0" Foreground="#888888" TextWrapping="Wrap"
                         Text="BITS jobs show their source URL and local file. Browser partial files are detected in your Downloads folder; custom download folders and URL details are unavailable. Delivery Optimization uses another system, and encrypted HTTPS counters cannot reveal package names."/>
            </Grid>
          </TabItem>
        </TabControl>
    </Grid>
</Window>
