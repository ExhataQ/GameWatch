<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameWatch</AssemblyName>
    <RootNamespace>GameWatch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Microsoft package. Restores automatically the first time
         you build (needs internet once); no other external code. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
